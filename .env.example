# ============================================================
# DROGUERÍA PILAR — Variables de entorno (PLANTILLA)
# Copia como .env para desarrollo local.
# En Vercel, añade estas variables en Project → Settings → Environment Variables.
# NUNCA subas .env a Git.
# ============================================================

# ── Base de datos (Railway) ──────────────────────────────────
# Copia desde Railway → tu proyecto → PostgreSQL → Variables → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"


# ── NextAuth ─────────────────────────────────────────────────
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_REAL"

# URL pública de tu dominio en Vercel (sin barra final):
NEXTAUTH_URL="https://drogueria-pilar.vercel.app"

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV="production"
